    <SolidColorBrush x:Key="Projectmanager">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Studio">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Localmain">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Plcscan">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Watchdog">#FFFFFF</SolidColorBrush>

        <SolidColorBrush x:Key="Exportserver">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Langtool">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Localconfig">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Sms">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Runmain">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Viewmain">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Opcdaclient">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Opcuaclient">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Opcuaserver">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Apiclient">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Registernet">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Registernet32">#FFFFFF</SolidColorBrush>


