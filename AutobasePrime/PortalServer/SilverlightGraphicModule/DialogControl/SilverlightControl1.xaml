        <StackPanel>
            <Grid Height="100">
                <Rectangle Margin="0,0,0,0" Stroke="red" Height="1" VerticalAlignment="Top" />
                <!--Rectangle Margin="0,0,0,0" Stroke="Black" /-->
                <Rectangle Margin="1,1,1,1" Stroke="White" />
                <Rectangle Margin="2,2,2,2" Stroke="Black" />
            </Grid>
            <Rectangle Width="100" Height="100" Stroke="Black" StrokeThickness="10"></Rectangle>
            <Grid Height="70" Background="Blue">
                
            </Grid>
        </StackPanel>
        <Path Height="80" HorizontalAlignment="Left" Margin="86,0,0,68" VerticalAlignment="Bottom" Width="87" Fill="#FFFFFFFF" Stretch="Fill" Stroke="#FF000000" Data="M86,152 L172,231" StrokeThickness="20"/>
        <TextBlock Text="Hello" Height="70" Width="18"></TextBlock>
        <TextBox HorizontalAlignment="Left" Margin="192,132,0,84" Width="102" Text="TextBox" TextWrapping="Wrap"/>
        <TextBlock HorizontalAlignment="Left" Margin="192,62,0,141" Width="208" Text="TextBlock" TextWrapping="Wrap" Foreground="#FFAFCF3D"/>
        <Image HorizontalAlignment="Left" Margin="126,114,0,84" Width="130.333" Source="Resources/WaitImage.PNG" Stretch="Fill"/>
        
    </Grid>
</UserControl>
