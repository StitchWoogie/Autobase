<UserControl 
    xmlns:basics="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls"
    x:Class="SilverlightApplication1.SilverlightControl1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    Width="500" Height="400">
    <Grid x:Name="LayoutRoot" Background="LightGray">
        <Grid Background="White" Margin="3,3,3,100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="Red"/>
            <Rectangle Grid.Column="1" Fill="Blue"/>

            <basics:GridSplitter Grid.ColumnSpan="1" Width="3" VerticalAlignment="Stretch" Background="Aqua"></basics:GridSplitter>
        </Grid>
        <Grid Background="Wheat" Margin="3,303,3,3">

        </Grid>
    </Grid>
</UserControl>
